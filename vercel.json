{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(media|design-system/assets|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/data/temps.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/creations/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/composition/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/composition/:id",
      "destination": "/creation.html"
    },
    {
      "source": "/chronologie",
      "destination": "/chronologie.html"
    },
    {
      "source": "/composition",
      "destination": "/composition.html"
    },
    {
      "source": "/importer",
      "destination": "/importer.html"
    },
    {
      "source": "/vue-cube",
      "destination": "/vue-cube.html"
    },
    {
      "source": "/ecosysteme",
      "destination": "/ecosysteme.html"
    },
    {
      "source": "/moteur",
      "destination": "/moteur.html"
    },
    {
      "source": "/administration",
      "destination": "/administration.html"
    },
    {
      "source": "/creation",
      "destination": "/creation.html"
    },
    {
      "source": "/metamorphose",
      "destination": "/metamorphose.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/cube",
      "destination": "/cube.html"
    },
    {
      "source": "/mariage",
      "destination": "/mariage.html"
    },
    {
      "source": "/atlas",
      "destination": "/chronologie.html"
    }
  ]
}
